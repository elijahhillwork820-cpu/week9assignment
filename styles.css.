
/* Basic page setup */
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
    background-color: #FFFBE6;
    color: #333333;
    line-height: 1.6;
}

/* Main business heading */
header {
    background-color: #F4C542;
    color: #333333;
    text-align: center;
    padding: 30px 20px;
}

header h1 {
    margin-bottom: 10px;
    font-size: 2.2rem;
}

header p {
    font-size: 1.1rem;
}

/* Food truck photograph */
header img {
    width: 100%;
    max-width: 650px;
    height: auto;
    display: block;
    margin: 25px auto;
    border-radius: 12px;
    border: 4px solid #E6A817;
}

/* Phone and tablet adjustments */
@media (max-width: 600px) {
    header {
        padding: 20px 15px;
    }

    header h1 {
        font-size: 1.7rem;
    }

    header p {
        font-size: 1rem;
    }
}
